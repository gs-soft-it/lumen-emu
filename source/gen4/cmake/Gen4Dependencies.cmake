include_guard(GLOBAL)
file(READ "${CMAKE_CURRENT_LIST_DIR}/../tools/dependencies.lock.json" gen4_lock)
string(JSON gen4_dependency_count LENGTH "${gen4_lock}" dependencies)
math(EXPR gen4_dependency_last "${gen4_dependency_count} - 1")
foreach(index RANGE 0 ${gen4_dependency_last})
    string(JSON name GET "${gen4_lock}" dependencies ${index} name)
    if(name STREQUAL "ext-wepoll" AND NOT WIN32)
        continue()
    endif()
    if((name STREQUAL "zarchive" OR name STREQUAL "zstd") AND
       NOT (ENABLE_FEX_GUEST_CPU))
        continue()
    endif()
    string(JSON repository_path ERROR_VARIABLE repository_path_error
        GET "${gen4_lock}" dependencies ${index} repository_path)
    if(repository_path_error)
        set(dependency_source "${LUMEN_GEN4_DEPS_DIR}/${name}")
    else()
        get_filename_component(dependency_source
            "${CMAKE_CURRENT_LIST_DIR}/../../../${repository_path}" ABSOLUTE)
    endif()
    if(name STREQUAL "sirit")
        set(LUMEN_GEN4_SIRIT_SOURCE_DIR "${dependency_source}")
    endif()
    if(NOT IS_DIRECTORY "${dependency_source}")
        message(FATAL_ERROR "Missing pinned Gen4 dependency ${name}; run tools/prepare_dependencies.py")
    endif()
    string(JSON expected GET "${gen4_lock}" dependencies ${index} commit)
    execute_process(COMMAND git -C "${dependency_source}" rev-parse HEAD
        OUTPUT_VARIABLE observed OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT observed STREQUAL expected)
        message(FATAL_ERROR "Gen4 dependency pin mismatch: ${name}")
    endif()
endforeach()

if(NOT EXISTS "${LUMEN_GEN4_FFMPEG_PREBUILT_DIR}/include/libavcodec/avcodec.h")
    message(FATAL_ERROR "Set LUMEN_GEN4_FFMPEG_PREBUILT_DIR to the host's native FFmpeg static package")
endif()
add_library(lumen_gen4_ffmpeg INTERFACE)
add_library(FFmpeg::ffmpeg ALIAS lumen_gen4_ffmpeg)
target_include_directories(lumen_gen4_ffmpeg INTERFACE "${LUMEN_GEN4_FFMPEG_PREBUILT_DIR}/include")
foreach(part avformat avcodec swscale avutil avfilter swresample)
    set(archive "${LUMEN_GEN4_FFMPEG_PREBUILT_DIR}/lib/lib${part}.a")
    if(NOT EXISTS "${archive}")
        message(FATAL_ERROR "Missing native FFmpeg archive: ${archive}")
    endif()
    target_link_libraries(lumen_gen4_ffmpeg INTERFACE "${archive}")
endforeach()
if(APPLE)
    target_link_libraries(lumen_gen4_ffmpeg INTERFACE
        "-framework CoreServices" "-framework CoreFoundation" "-framework AudioUnit"
        "-framework AudioToolbox" "-framework CoreAudio" "-framework CoreMedia"
        "-framework VideoToolbox" "-framework CoreVideo" "-framework Security")
endif()
