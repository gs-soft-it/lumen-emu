+void CheckVertexNggLaneExtent() {
+  constexpr const char *name = "VertexNggLaneExtent";
+  for (const u32 wave_size : {32u, 64u}) {
+    // Export the generated NGG ABI value through a real guest instruction.
+    // A population count cannot describe physical invocation ordinals when
+    // active vertices occupy a sparse or offset subgroup mask.
+    std::vector<u32> code{EncodeVop1(0x01u, 0, 3u),
+                          EncodeExp0(0x0c, 0xf), EncodeExp1(0, 0, 0, 0)};
+    AppendEnd(&code);
+    ShaderVertexInputInfo vertex{};
+    ShaderRecompiler::CompileOptions options;
+    options.stage = ShaderType::Vertex;
+    options.wave_size = wave_size;
+    options.input_info.vertex = &vertex;
+    auto translated = ShaderRecompiler::TranslateProgram(code, options);
+    auto compiled = ShaderRecompiler::CompileProgram(std::move(translated), options, {});
+    ValidateSpirv(name, compiled.spirv);
+    std::optional<u32> extent;
+    for (const auto *block : compiled.program.blocks) {
+      for (const auto &inst : *block) {
+        if (inst.GetOpcode() != ShaderRecompiler::IR::ValueOpcode::SetAttribute ||
+            inst.Arg(0).IsImmediate()) continue;
+        const auto *components = inst.Arg(0).Instruction();
+        if (components->GetOpcode() == ShaderRecompiler::IR::ValueOpcode::CompositeConstructU32x4 &&
+            components->Arg(0).IsImmediate()) {
+          extent = components->Arg(0).U32() & 0xffu;
+        }
+      }
+    }
+    Require(name, "NGG lane extent", extent.has_value() && *extent == wave_size,
+            "generated ESVertCount must retain physical lane extent, not active population");
+    const uint64_t guest_exec = UINT64_MAX >> ((64u - *extent) & 63u);
+    const std::array<uint64_t, 3> active_masks = wave_size == 32u
+        ? std::array<uint64_t, 3>{0x12u, 0x80000001u, 0xf0000000u}
+        : std::array<uint64_t, 3>{0x8000000000000001ull, 0x0000000f00000000ull,
+                                  0x9000000010000010ull};
+    for (const auto active : active_masks) {
+      Require(name, "sparse/offset lane survival", (active & guest_exec) == active,
+              "NGG prolog suppresses an active physical vertex lane");
+      const auto count_exec = UINT64_MAX >> ((64u - std::popcount(active)) & 63u);
+      Require(name, "regression witness", (active & count_exec) != active,
+              "fixture must distinguish lane extent from an active population count");
+    }
+  }
+  std::printf("[host]    %-32s ok\n", name);
 }
 
