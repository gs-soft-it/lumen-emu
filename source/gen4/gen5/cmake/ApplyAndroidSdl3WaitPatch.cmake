# SDL 3.4.16, official release commit fa2c02bb6e21974a89ea9824bc53c9932abe5f9c.
# Keep the vendored dependency unchanged. Patch only its generated Android copy.
# Matching patch: ../tools/sdl3-android-wait.patch; fixture: ../tests/Sdl3AndroidWaitTests.py.
function(lumen_ps5_patch_android_sdl_wait source_dir generated_dir pin_manifest)
  if(NOT ANDROID)
    message(FATAL_ERROR "SDL3 wait patch is restricted to the Android source copy")
  endif()
  file(REAL_PATH "${source_dir}" source_root)
  file(REAL_PATH "${generated_dir}" generated_root)
  if(source_root STREQUAL generated_root)
    message(FATAL_ERROR "SDL3 wait patch must not modify the vendored source")
  endif()
  set(source_file "${source_root}/src/events/SDL_events.c")
  set(generated_file "${generated_root}/src/events/SDL_events.c")
  foreach(path IN ITEMS "${source_file}" "${generated_file}" "${pin_manifest}")
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
      message(FATAL_ERROR "SDL3 wait patch requires regular reviewed input files: ${path}")
    endif()
  endforeach()
  file(READ "${pin_manifest}" pins)
  string(JSON count LENGTH "${pins}" submodules)
  math(EXPR last "${count}-1")
  set(sdl_pin_count 0)
  foreach(index RANGE 0 ${last})
    string(JSON path GET "${pins}" submodules ${index} path)
    if(path STREQUAL "3rdparty/SDL3")
      string(JSON pin GET "${pins}" submodules ${index} commit)
      if(NOT pin STREQUAL "fa2c02bb6e21974a89ea9824bc53c9932abe5f9c")
        message(FATAL_ERROR "SDL3 wait patch upstream pin mismatch")
      endif()
      math(EXPR sdl_pin_count "${sdl_pin_count}+1")
    endif()
  endforeach()
  if(NOT sdl_pin_count EQUAL 1)
    message(FATAL_ERROR "SDL3 wait patch requires exactly one upstream SDL3 pin")
  endif()
  file(READ "${source_root}/CMakeLists.txt" sdl_cmake)
  string(FIND "${sdl_cmake}" "project(SDL3 LANGUAGES C VERSION \"3.4.16\")" version_position)
  if(version_position LESS 0)
    message(FATAL_ERROR "SDL3 wait patch release tag/version mismatch")
  endif()
  file(SHA256 "${source_file}" source_sha)
  if(NOT source_sha STREQUAL "ef6301f9416c6960c5f37fc9d8ed38a5624fbd246fa4da0ac02a8351bcb172d7")
    message(FATAL_ERROR "SDL3 wait patch upstream events SHA-256 mismatch")
  endif()
  if(NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
      "${source_file}" "${source_root}/CMakeLists.txt" "${pin_manifest}"
      "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
  endif()
  set(patched_sha "1f47de40fd3d9cdc7bc224a74b57bc782bb8ae76148338f02c9130ef6790e5c6")
  file(SHA256 "${generated_file}" generated_sha)
  if(generated_sha STREQUAL patched_sha)
    # Re-entry may verify the exact reviewed output, never apply it twice.
    return()
  endif()
  if(NOT generated_sha STREQUAL source_sha)
    message(FATAL_ERROR "SDL3 wait patch generated copy differs from reviewed upstream")
  endif()
  file(READ "${source_file}" events)
  set(before [=[#ifdef SDL_PLATFORM_ANDROID
    for (;;) {
        SDL_PumpEventsInternal(true);]=])
  set(after [=[#ifdef SDL_PLATFORM_ANDROID
    for (;;) {
        // The initial pump above preserves the poll sentinel. Subsequent wait
        // pumps must not queue a sentinel that wakes this same Android thread.
        SDL_PumpEventsInternal(false);]=])
  string(FIND "${events}" "${before}" first)
  if(first LESS 0)
    message(FATAL_ERROR "SDL3 wait patch reviewed Android wait loop is absent")
  endif()
  string(LENGTH "${before}" before_length)
  math(EXPR remainder_start "${first}+${before_length}")
  string(SUBSTRING "${events}" ${remainder_start} -1 remainder)
  string(FIND "${remainder}" "${before}" second)
  if(NOT second LESS 0)
    message(FATAL_ERROR "SDL3 wait patch reviewed Android wait loop is ambiguous")
  endif()
  string(REPLACE "${before}" "${after}" events "${events}")
  string(REPLACE "bool SDL_WaitEventTimeoutNS(SDL_Event *event, Sint64 timeoutNS)\n{"
    "/* Lumen altered Android wait, 2026-10-02: avoid poll-sentinel self-wake. */\nbool SDL_WaitEventTimeoutNS(SDL_Event *event, Sint64 timeoutNS)\n{"
    events "${events}")
  string(SHA256 actual_patched_sha "${events}")
  if(NOT actual_patched_sha STREQUAL patched_sha)
    message(FATAL_ERROR "SDL3 wait patch reviewed output SHA-256 mismatch")
  endif()
  file(WRITE "${generated_file}" "${events}")
endfunction()
