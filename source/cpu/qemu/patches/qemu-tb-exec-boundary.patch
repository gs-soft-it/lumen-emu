+/* Private embedding optimization; normal work producers keep their ordering. */
+bool lumen_async_run_on_cpu_coalesced(CPUState *cpu, run_on_cpu_func func)
+{
+    struct qemu_work_item *wi;
+    bool queued;
+
+    assert(bql_locked());
+    qemu_mutex_lock(&cpu->work_mutex);
+    wi = QSIMPLEQ_LAST(&cpu->work_list, qemu_work_item, node);
+    queued = !wi || wi->func != func || !wi->free || wi->exclusive ||
+        wi->data.host_ptr != NULL;
+    if (queued) {
+        wi = g_new0(struct qemu_work_item, 1);
+        wi->func = func;
+        wi->data = RUN_ON_CPU_NULL;
+        wi->free = true;
+        QSIMPLEQ_INSERT_TAIL(&cpu->work_list, wi, node);
+    }
+    qemu_mutex_unlock(&cpu->work_mutex);
+
+    /* Keep every commit's exit request, even when its job was merged. */
+    cpu_exit(cpu);
+    return queued;
 }
 
