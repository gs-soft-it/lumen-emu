+// SPDX-License-Identifier: MIT
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+// Private embedding ABI. A preserving provider is a separate symbol so a
+// native cache can never rebind a reduced-spill call to an ordinary ABI callee.
+#if defined(__APPLE__) && defined(__clang__) && __has_attribute(preserve_all) && \
+    defined(FEX_HAS_PRESERVE_ALL_ATTR) && FEX_HAS_PRESERVE_ALL_ATTR && defined(FEX_PRESERVE_ALL_ATTR)
+#define FEX_LUMEN_HAS_MEMORY_PRESERVE_ALL_ABI 1
+#define FEX_LUMEN_MEMORY_PRESERVE_ALL_ABI FEX_PRESERVE_ALL_ATTR
+#else
+#define FEX_LUMEN_HAS_MEMORY_PRESERVE_ALL_ABI 0
+#define FEX_LUMEN_MEMORY_PRESERVE_ALL_ABI
+#endif
+
+using FEXLumenMemoryCheckV1 = std::uint32_t (*)(std::uint64_t, std::uint64_t,
+  std::uint32_t, std::uint64_t) noexcept;
+using FEXLumenMemoryPreserveAllCheckV1 = std::uint32_t (FEX_LUMEN_MEMORY_PRESERVE_ALL_ABI *)(
+  std::uint64_t, std::uint64_t, std::uint32_t, std::uint64_t) noexcept;
+extern "C" FEXLumenMemoryCheckV1 FEXLumenGuestMemoryCheckProviderV1() noexcept;
+extern "C" FEXLumenMemoryPreserveAllCheckV1 FEXLumenGuestMemoryPreserveAllProviderV1() noexcept;
+
+// A process-lifetime directory loaded with acquire by generated code. Null
+// table means the owner proved all GPU dirty intervals empty. Non-null table
+// retains the ordinary conservative page guards. Only Read uses this proof.
+using FEXLumenMemoryReadGuardDirectoryV1 = const std::atomic<const std::uint8_t*>*;
+static_assert(std::atomic<const std::uint8_t*>::is_always_lock_free);
+static_assert(sizeof(std::atomic<const std::uint8_t*>) == sizeof(const std::uint8_t*));
+extern "C" FEXLumenMemoryReadGuardDirectoryV1 FEXLumenGuestMemoryReadGuardProviderV1() noexcept;
