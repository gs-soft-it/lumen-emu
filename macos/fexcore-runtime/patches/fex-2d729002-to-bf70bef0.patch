+#ifdef __APPLE__
+// MAP_JIT permissions are selected per thread on Darwin. Compilation can be
+// nested through Custom-IR and cache-management paths, so only the outermost
+// scope opens and closes the write window.
+inline thread_local uint32_t JITWriteScopeDepth {};
+
+class ScopedJITWriteProtection final {
+public:
+  ScopedJITWriteProtection() {
+    if (JITWriteScopeDepth++ == 0) {
+      pthread_jit_write_protect_np(0);
+    }
+  }
+
+  ~ScopedJITWriteProtection() {
+    if (--JITWriteScopeDepth == 0) {
+      pthread_jit_write_protect_np(1);
+    }
+  }
+
+  ScopedJITWriteProtection(const ScopedJITWriteProtection&) = delete;
+  ScopedJITWriteProtection& operator=(const ScopedJITWriteProtection&) = delete;
+};
+#else
+class ScopedJITWriteProtection final {
+public:
+  ScopedJITWriteProtection() = default;
+};
+#endif
