+// Reserve before writing to the temporary emitter buffer: the embedding signal
+// adapter routes guest faults and does not longjmp out of native code generation.
+void Arm64JITCore::EnsureLumenJITSpace(uint64_t RequiredSpace) {
+#ifdef __APPLE__
+  if (FEXLumenDirectUnalignedTsoEnabledV1() == 0) return;
+  const auto Cursor = GetCursorOffset();
+  const auto Capacity = GetBufferSize();
+  if (Cursor > Capacity || Capacity - Cursor < RequiredSpace) {
+    FEXLumenDirectUnalignedTsoRestartV1();
+    FEXCore::UncheckedLongJump::LongJump(ThreadState->RestartJump,
+      FEXCore::ToUnderlying(RestartOptions::Control::NeedsLargerJITSpace));
+  }
+#endif
+}
