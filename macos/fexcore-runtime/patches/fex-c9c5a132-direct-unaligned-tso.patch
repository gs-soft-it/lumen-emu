+bool Arm64JITCore::EmitLumenDirectUnalignedTso(IR::OpSize Size, ARMEmitter::Register Base,
+                                             IR::OrderedNodeWrapper Offset, ARMEmitter::Register Data,
+                                             bool Write, ARMEmitter::ForwardLabel* Done) {
+#ifdef __APPLE__
+  const auto Bytes = IR::OpSizeToSize(Size);
+  if (FEXLumenDirectUnalignedTsoEnabledV1() == 0 ||
+      (Bytes != 2 && Bytes != 4 && Bytes != 8)) return false;
+  LOGMAN_THROW_A_FMT(Done != nullptr, "Direct unaligned TSO requires a continuation");
+  // Scalar split-granule sequence, including the complete ABI spill/fill, is
+  // bounded by 4096 bytes. Reserve before its first instruction.
+  EnsureLumenJITSpace(4096);
+  uint64_t Constant = 0;
+  if (!Offset.IsInvalid()) {
+    LOGMAN_THROW_A_FMT(IsInlineConstant(Offset, &Constant), "TSO offset must be immediate");
+  }
+  mov(ARMEmitter::Size::i64Bit, TMP2, Base);
+  if (Constant != 0) {
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Constant);
+    add(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP1);
+  }
+  // AND/ADD/TBZ leave NZCV intact. Naturally aligned and intra-granule
+  // accesses retain the original native acquire/release instruction.
+  and_(ARMEmitter::Size::i64Bit, TMP1, TMP2, 15);
+  add(ARMEmitter::Size::i64Bit, TMP1, TMP1, Bytes - 1);
+  ARMEmitter::ForwardLabel Native;
+  tbz_OrRestart(TMP1, 4, &Native);
+
+  constexpr auto FPSR = static_cast<ARMEmitter::SystemRegister>(
+    ARMEmitter::GenSystemReg<0b11, 0b011, 0b0100, 0b0100, 0b001>);
+  constexpr uint32_t FrameSize = 160;
+  sub(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, FrameSize);
+  str(TMP2, ARMEmitter::Reg::rsp, 32);
+  str(ARMEmitter::XReg::x30, ARMEmitter::Reg::rsp, 40);
+  if (Write) str(Data.X(), ARMEmitter::Reg::rsp, 48);
+  stp<ARMEmitter::IndexType::OFFSET>(TMP3, TMP4, ARMEmitter::Reg::rsp, 64);
+  if (HostSupportsSVE256) {
+    mov(TMP1, 96);
+    st1b<ARMEmitter::SubRegSize::i8Bit>(VTMP1.Z(), PRED_TMP_32B, ARMEmitter::Reg::rsp, TMP1);
+    mov(TMP1, 128);
+    st1b<ARMEmitter::SubRegSize::i8Bit>(VTMP2.Z(), PRED_TMP_32B, ARMEmitter::Reg::rsp, TMP1);
+  } else {
+    stp<ARMEmitter::IndexType::OFFSET>(VTMP1.Q(), VTMP2.Q(), ARMEmitter::Reg::rsp, 96);
+  }
+  mrs(TMP1, ARMEmitter::SystemRegister::NZCV);
+  str(TMP1, ARMEmitter::Reg::rsp, 0);
+  mrs(TMP1, ARMEmitter::SystemRegister::FPCR);
+  str(TMP1, ARMEmitter::Reg::rsp, 8);
+  mrs(TMP1, FPSR);
+  str(TMP1, ARMEmitter::Reg::rsp, 16);
+  const auto SpillSize = SpillForABICall(false, TMP1);
+  ldr(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, SpillSize + 32);
+  LoadConstant(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r1, Bytes);
+  LoadConstant(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r2, Write ? 1 : 0);
+  if (Write) ldr(ARMEmitter::XReg::x3, ARMEmitter::Reg::rsp, SpillSize + 48);
+  else mov(ARMEmitter::XReg::x3, 0);
+  add(ARMEmitter::Size::i64Bit, ARMEmitter::XReg::x4, ARMEmitter::Reg::rsp, SpillSize + 56);
+  LOGMAN_THROW_A_FMT(!DebugData->GuestOpcodes.empty(), "Direct helper requires a precise guest opcode");
+  InsertGuestRIPMove(ARMEmitter::Reg::r5, Entry + DebugData->GuestOpcodes.back().GuestEntryOffset);
+  ldr(ARMEmitter::XReg::x16, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.LumenDirectUnalignedTso));
+  blr(ARMEmitter::XReg::x16);
+  str(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, SpillSize + 24);
+  FillForABICall(false);
+  if (HostSupportsSVE256) {
+    mov(TMP1, 96);
+    ld1b<ARMEmitter::SubRegSize::i8Bit>(VTMP1.Z(), PRED_TMP_32B.Zeroing(), ARMEmitter::Reg::rsp, TMP1);
+    mov(TMP1, 128);
+    ld1b<ARMEmitter::SubRegSize::i8Bit>(VTMP2.Z(), PRED_TMP_32B.Zeroing(), ARMEmitter::Reg::rsp, TMP1);
+  } else {
+    ldp<ARMEmitter::IndexType::OFFSET>(VTMP1.Q(), VTMP2.Q(), ARMEmitter::Reg::rsp, 96);
+  }
+  ldr(TMP1, ARMEmitter::Reg::rsp, 0);
+  msr(ARMEmitter::SystemRegister::NZCV, TMP1);
+  ldr(TMP1, ARMEmitter::Reg::rsp, 8);
+  msr(ARMEmitter::SystemRegister::FPCR, TMP1);
+  ldr(TMP1, ARMEmitter::Reg::rsp, 16);
+  msr(FPSR, TMP1);
+  ldr(ARMEmitter::XReg::x30, ARMEmitter::Reg::rsp, 40);
+  ldp<ARMEmitter::IndexType::OFFSET>(TMP3, TMP4, ARMEmitter::Reg::rsp, 64);
+  ldr(TMP1, ARMEmitter::Reg::rsp, 24);
+  ARMEmitter::ForwardLabel Allowed;
+  cbnz_OrRestart(ARMEmitter::Size::i64Bit, TMP1, &Allowed);
+  add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, FrameSize);
+  // Permission rejection is precise and occurs before the FEX helper can
+  // read or modify any guest byte. Registers and status are already restored.
+  brk(0x4c55);
+  BindOrRestart(&Allowed);
+  if (!Write) ldr(Data.X(), ARMEmitter::Reg::rsp, 56);
+  add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, FrameSize);
+  b_OrRestart(Done);
+  BindOrRestart(&Native);
+  return true;
 #else
   return false;
 #endif
