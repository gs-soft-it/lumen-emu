 inline void VirtualDontNeed(void* Ptr, size_t Size, bool Recommit = true) {
+#ifdef __APPLE__
+  // Darwin's MADV_DONTNEED does not guarantee that subsequent reads observe
+  // zero-filled pages. FEX lookup caches rely on Linux's zero-on-reuse
+  // contract when dropping L1/L2 state, so explicitly clear the retained
+  // mapping on Darwin. All current executable callers hold the JIT write
+  // scope before reaching this helper.
+  std::memset(Ptr, 0, Size);
+#else
   ::madvise(reinterpret_cast<void*>(Ptr), Size, MADV_DONTNEED);
+#endif
 }
