+#ifdef __APPLE__
+// Diagnostic-only link hook. The default provider returns no callback, keeping
+// direct code generation and the uniform-host-page VM contract in the product.
+using LumenMemoryCheck = uint32_t (*)(uint64_t Address, uint64_t Bytes,
+                                     uint32_t Write, uint64_t GuestRIP) noexcept;
+extern "C" __attribute__((weak, noinline)) LumenMemoryCheck FEXLumenGuestMemoryCheckProviderV1() noexcept {
+  return nullptr;
+}
+#endif
+
+void Arm64JITCore::EmitLumenGuestMemoryCheck(IR::OpSize Size, ARMEmitter::Register Base,
+                                          IR::OrderedNodeWrapper Offset, IR::MemOffsetType OffsetType,
+                                          uint8_t OffsetScale, bool Write) {
+#ifdef __APPLE__
+  const auto Check = FEXLumenGuestMemoryCheckProviderV1();
+  if (Check == nullptr) return;
+  constexpr auto FPSR = static_cast<ARMEmitter::SystemRegister>(
+    ARMEmitter::GenSystemReg<0b11, 0b011, 0b0100, 0b0100, 0b001>);
+  // This first experimental hook covers ordinary scalar data accesses. Other
+  // memory families must be checked before mixed mappings can enter product.
+  uint64_t Constant;
+  if (!Offset.IsInvalid() && IsInlineConstant(Offset, &Constant)) {
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP2, Constant);
+    add(ARMEmitter::Size::i64Bit, TMP2, Base, TMP2);
+  } else {
+    const auto Address = ApplyMemOperand(Size, Base, TMP2, Offset, OffsetType, OffsetScale);
+    if (Address != TMP2) mov(ARMEmitter::Size::i64Bit, TMP2, Address);
+  }
+  sub(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, 64);
+  str(TMP2, ARMEmitter::Reg::rsp, 32);
+  str(ARMEmitter::XReg::x30, ARMEmitter::Reg::rsp, 40);
+  mrs(TMP1, ARMEmitter::SystemRegister::NZCV);
+  str(TMP1, ARMEmitter::Reg::rsp, 0);
+  mrs(TMP1, ARMEmitter::SystemRegister::FPCR);
+  str(TMP1, ARMEmitter::Reg::rsp, 8);
+  mrs(TMP1, FPSR);
+  str(TMP1, ARMEmitter::Reg::rsp, 16);
+  const auto SpillSize = SpillForABICall(false, TMP1);
+  ldr(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, SpillSize + 32);
+  LoadConstant(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r1, IR::OpSizeToSize(Size));
+  LoadConstant(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r2, Write ? 1 : 0);
+  LOGMAN_THROW_A_FMT(!DebugData->GuestOpcodes.empty(), "Memory check requires a precise guest opcode");
+  InsertGuestRIPMove(ARMEmitter::Reg::r3, Entry + DebugData->GuestOpcodes.back().GuestEntryOffset);
+  LoadConstant(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r16,
+               reinterpret_cast<uintptr_t>(Check));
+  blr(ARMEmitter::Reg::r16);
+  str(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, SpillSize + 24);
+  FillForABICall(false);
+  ldr(TMP1, ARMEmitter::Reg::rsp, 0);
+  msr(ARMEmitter::SystemRegister::NZCV, TMP1);
+  ldr(TMP1, ARMEmitter::Reg::rsp, 8);
+  msr(ARMEmitter::SystemRegister::FPCR, TMP1);
+  ldr(TMP1, ARMEmitter::Reg::rsp, 16);
+  msr(FPSR, TMP1);
+  ldr(TMP2, ARMEmitter::Reg::rsp, 24);
+  ldr(ARMEmitter::XReg::x30, ARMEmitter::Reg::rsp, 40);
+  add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, 64);
+  ARMEmitter::ForwardLabel Allowed;
+  cbnz_OrRestart(ARMEmitter::Size::i64Bit, TMP2, &Allowed);
+  // Restored registers and status precede the trap, and the original access
+  // has not executed. The embedding experiment records the denied descriptor.
+  brk(0x4c4d);
+  BindOrRestart(&Allowed);
+#endif
+}
