+bool Arm64JITCore::HasLumenGuestMemoryChecks() const {
+#ifdef __APPLE__
+  return FEXLumenGuestMemoryCheckProviderV1() != nullptr;
+#else
+  return false;
+#endif
+}
+
 void Arm64JITCore::EmitLumenGuestMemoryCheck(IR::OpSize Size, ARMEmitter::Register Base,
                                           IR::OrderedNodeWrapper Offset, IR::MemOffsetType OffsetType,
                                           uint8_t OffsetScale, bool Write) {
+  EmitLumenGuestMemoryCheckImpl(IR::OpSizeToSize(Size), [=, this] {
+    uint64_t Constant;
+    if (!Offset.IsInvalid() && IsInlineConstant(Offset, &Constant)) {
+      // Immediate memory operands are byte offsets, independent of OffsetScale.
+      // Copy the base first so the helper also accepts a scratch register base.
+      mov(ARMEmitter::Size::i64Bit, TMP2, Base);
+      LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Constant);
+      add(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP1);
+    } else {
+      const auto Address = ApplyMemOperand(Size, Base, TMP2, Offset, OffsetType, OffsetScale);
+      if (Address != TMP2) mov(ARMEmitter::Size::i64Bit, TMP2, Address);
+    }
+  }, Write);
+}
+
+void Arm64JITCore::EmitLumenGuestMemoryCheckBytes(uint64_t Bytes, ARMEmitter::Register Base,
+                                               int64_t Displacement, bool Write) {
+  EmitLumenGuestMemoryCheckImpl(Bytes, [=, this] {
+    mov(ARMEmitter::Size::i64Bit, TMP2, Base);
+    if (Displacement != 0) {
+      LoadConstant(ARMEmitter::Size::i64Bit, TMP1, static_cast<uint64_t>(Displacement));
+      add(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP1);
+    }
+  }, Write);
+}
