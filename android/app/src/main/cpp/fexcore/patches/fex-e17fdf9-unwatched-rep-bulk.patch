+  }
+  mrs(TMP1, ARMEmitter::SystemRegister::NZCV);
+  str(TMP1, ARMEmitter::Reg::rsp, 0);
+  mrs(TMP1, ARMEmitter::SystemRegister::FPCR);
+  str(TMP1, ARMEmitter::Reg::rsp, 8);
+  mrs(TMP1, FPSR);
+  str(TMP1, ARMEmitter::Reg::rsp, 16);
+  const auto SpillSize = SpillForABICall(false, TMP1);
+  ldr(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, SpillSize + 56);
+  if (Copy) ldr(ARMEmitter::XReg::x1, ARMEmitter::Reg::rsp, SpillSize + 64);
+  else LoadConstant(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r1, 0);
+  ldr(ARMEmitter::XReg::x2, ARMEmitter::Reg::rsp, SpillSize + 48);
+  LoadConstant(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r3, ElementSize | (Copy ? 0x100U : 0U));
