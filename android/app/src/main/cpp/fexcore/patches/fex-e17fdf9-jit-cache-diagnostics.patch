new file mode 100644
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/LumenJitCacheDiagnostics.h
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cstdint>
+
+// Cold embedding diagnostics only: no guest addresses, code writes, or execution
+// state are exposed. A default no-op lives in SharedCodeBufferManager.cpp.
+enum class FEXLumenJitCacheEventV1 : std::uint32_t {
+  BufferAllocate = 1, BufferClear = 2, BufferAdopt = 3,
+  BlockCompile = 4, BlockLoad = 5, InvalidateBlocks = 6,
+  InvalidateRequest = 7, RestartFar = 8, RestartBuffer = 9,
+  ExplicitClear = 10,
+};
+extern "C" void FEXLumenJitCacheActivityV1(std::uint32_t kind,
+  std::uint64_t value, std::uint64_t detail) noexcept;
+inline void FEXLumenJitCacheActivityV1(FEXLumenJitCacheEventV1 kind,
+  std::uint64_t value, std::uint64_t detail = 0) noexcept {
+  FEXLumenJitCacheActivityV1(static_cast<std::uint32_t>(kind), value, detail);
+}
