+void Arm64JITCore::EmitLumenMaskedMemoryCheck(IR::OpSize Size, IR::OpSize ElementSize,
+                                             ARMEmitter::Register Base, ARMEmitter::VRegister Mask,
+                                             IR::OrderedNodeWrapper Offset, IR::MemOffsetType OffsetType,
+                                             uint8_t OffsetScale, bool Write) {
