+                                        (HostSupportsSVE128 || HostSupportsSVE256) ? 1 : OffsetScale);
+    if (Address != TMP3) mov(ARMEmitter::Size::i64Bit, TMP3, Address);
+  }
+  sub(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, 32);
