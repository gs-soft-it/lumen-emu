+}
+
+void Arm64JITCore::EmitLumenGatherMemoryCheck(IR::OpSize Size, IR::OpSize ElementSize,
+                                             std::optional<ARMEmitter::Register> BaseAddr,
+                                             ARMEmitter::VRegister VectorIndexLow,
+                                             std::optional<ARMEmitter::VRegister> VectorIndexHigh,
+                                             ARMEmitter::VRegister MaskReg, IR::OpSize VectorIndexSize,
+                                             size_t DataElementOffsetStart, size_t IndexElementOffsetStart,
+                                             uint8_t OffsetScale, IR::OpSize AddrSize) {
+  if (!HasLumenGuestMemoryChecks()) return;
+  const auto Bytes = IR::OpSizeToSize(ElementSize);
+  const auto IndexBytes = IR::OpSizeToSize(VectorIndexSize);
+  const auto IndexCount = (Size == IR::OpSize::i256Bit || VectorIndexHigh.has_value() ? 32 : 16) / IndexBytes;
+  const auto Count = std::min<size_t>(IR::OpSizeToSize(Size) / Bytes, IndexCount);
+  sub(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, 96);
+  if (Size == IR::OpSize::i256Bit) {
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP4, 0);
+    st1b<ARMEmitter::SubRegSize::i8Bit>(MaskReg.Z(), PRED_TMP_32B, ARMEmitter::Reg::rsp, TMP4);
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP4, 32);
+    st1b<ARMEmitter::SubRegSize::i8Bit>(VectorIndexLow.Z(), PRED_TMP_32B, ARMEmitter::Reg::rsp, TMP4);
+  } else {
+    str(MaskReg.Q(), ARMEmitter::Reg::rsp, 0);
+    str(VectorIndexLow.Q(), ARMEmitter::Reg::rsp, 32);
+    if (VectorIndexHigh.has_value()) str(VectorIndexHigh->Q(), ARMEmitter::Reg::rsp, 48);
+  }
+  for (size_t Lane = DataElementOffsetStart, Index = IndexElementOffsetStart; Lane < Count; ++Lane, ++Index) {
+    switch (Bytes) {
+    case 1: ldrb(TMP1.W(), ARMEmitter::Reg::rsp, Lane); break;
+    case 2: ldrh(TMP1.W(), ARMEmitter::Reg::rsp, Lane * 2); break;
+    case 4: ldr(TMP1.W(), ARMEmitter::Reg::rsp, Lane * 4); break;
+    case 8: ldr(TMP1, ARMEmitter::Reg::rsp, Lane * 8); break;
+    default: LOGMAN_THROW_A_FMT(false, "Unsupported checked gather element size");
+    }
+    ARMEmitter::ForwardLabel Skip;
+    (void)tbz(TMP1, Bytes * 8 - 1, &Skip);
+    switch (IndexBytes) {
+    case 4: ldr(TMP1.W(), ARMEmitter::Reg::rsp, 32 + Index * 4); break;
+    case 8: ldr(TMP1, ARMEmitter::Reg::rsp, 32 + Index * 8); break;
+    default: LOGMAN_THROW_A_FMT(false, "Unsupported checked gather index size");
+    }
+    if (BaseAddr.has_value()) {
+      if (VectorIndexSize == IR::OpSize::i32Bit) {
+        add(ConvertSize(AddrSize), TMP2, *BaseAddr, TMP1, ARMEmitter::ExtendedType::SXTW, FEXCore::ilog2(OffsetScale));
+      } else {
+        add(ConvertSize(AddrSize), TMP2, *BaseAddr, TMP1, ARMEmitter::ShiftType::LSL, FEXCore::ilog2(OffsetScale));
+      }
+    } else if (VectorIndexSize == IR::OpSize::i32Bit) {
+      sbfiz(ConvertSize(AddrSize), TMP2, TMP1, FEXCore::ilog2(OffsetScale), 32);
+    } else {
+      lsl(ConvertSize(AddrSize), TMP2, TMP1, FEXCore::ilog2(OffsetScale));
+    }
+    EmitLumenGuestMemoryCheckBytes(Bytes, TMP2, 0, false);
+    BindOrRestart(&Skip);
+  }
+  add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, 96);
+}
