+
+void Arm64JITCore::EmitLumenGuestMemoryCheck(IR::OpSize Size, ARMEmitter::Register Base,
+                                          IR::OrderedNodeWrapper Offset, IR::MemOffsetType OffsetType,
+                                          uint8_t OffsetScale, bool Write) {
+  EmitLumenGuestMemoryCheckImpl(IR::OpSizeToSize(Size), [=, this] {
+    uint64_t Constant;
+    if (!Offset.IsInvalid() && IsInlineConstant(Offset, &Constant)) {
+      // Immediate memory operands are byte offsets, independent of OffsetScale.
+      // Copy the base first so the helper also accepts a scratch register base.
+      mov(ARMEmitter::Size::i64Bit, TMP2, Base);
+      LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Constant);
+      add(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP1);
+    } else {
+      const auto Address = ApplyMemOperand(Size, Base, TMP2, Offset, OffsetType, OffsetScale);
+      if (Address != TMP2) mov(ARMEmitter::Size::i64Bit, TMP2, Address);
+    }
+  }, Write, false);
+}
+
+void Arm64JITCore::EmitLumenGuestMemoryCheckBytes(uint64_t Bytes, ARMEmitter::Register Base,
+                                               int64_t Displacement, bool Write) {
+  EmitLumenGuestMemoryCheckImpl(Bytes, [=, this] {
+    mov(ARMEmitter::Size::i64Bit, TMP2, Base);
+    if (Displacement != 0) {
+      LoadConstant(ARMEmitter::Size::i64Bit, TMP1, static_cast<uint64_t>(Displacement));
+      add(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP1);
+    }
+  }, Write, Base.Idx() == TMP1.Idx() || Base.Idx() == TMP2.Idx() ||
+             Base.Idx() == TMP3.Idx() || Base.Idx() == TMP4.Idx());
+}
+
+void Arm64JITCore::EmitLumenGuestMemoryCheckImpl(uint64_t Bytes, const std::function<void()>& EmitAddress, bool Write, bool PreserveScratch) {
+#if defined(__ANDROID__)
+  const auto Check = FEXLumenGuestMemoryCheckProviderV1();
+  if (Check == nullptr) return;
+  LOGMAN_THROW_A_FMT(Bytes != 0 && Bytes <= 4096, "Memory checks require a fixed footprint of at most one page");
+  constexpr auto FPSR = static_cast<ARMEmitter::SystemRegister>(
+    ARMEmitter::GenSystemReg<0b11, 0b011, 0b0100, 0b0100, 0b001>);
+  constexpr uint32_t FrameSize = 160;
+  const auto Guards = FEXLumenGuestMemoryHandoffGuardProviderV1();
+  // Persist symbolic relocations, never process-local ASLR addresses, in the
+  // native translation cache. Every load resolves against this runtime.
+  auto GuardAddress = InsertNamedSymbolLiteral(RelocNamedSymbolLiteral::NamedSymbol::SYMBOL_LITERAL_LUMEN_MEMORY_HANDOFF_GUARDS);
+  auto CheckAddress = InsertNamedSymbolLiteral(RelocNamedSymbolLiteral::NamedSymbol::SYMBOL_LITERAL_LUMEN_MEMORY_HANDOFF_CHECK);
+  ARMEmitter::ForwardLabel Slow, Done;
+  const auto ProbePage = [&] {
+    lsr(ARMEmitter::Size::i64Bit, TMP2, TMP2, 12);
+    and_(ARMEmitter::Size::i64Bit, TMP2, TMP2, (1U << 20) - 1);
+    ldr(TMP1, &GuardAddress.Loc);
+    add(ARMEmitter::Size::i64Bit, TMP1, TMP1, TMP2);
+    ldarb(TMP1.W(), TMP1);
+    cbnz_OrRestart(ARMEmitter::Size::i32Bit, TMP1, &Slow);
+  };
+  if (Guards && !PreserveScratch) {
+    // Ordinary scalar/SIMD/RMW accesses use reserved scratch registers: the
+    // hot path has no stack spill, ABI call or NZCV modification. The second
+    // guard load is required only when the <=4 KiB footprint crosses a page.
+    EmitAddress();
+    ProbePage();
+    if (Bytes != 1) {
+      EmitAddress();
+      and_(ARMEmitter::Size::i64Bit, TMP1, TMP2, 4095);
+      add(ARMEmitter::Size::i64Bit, TMP1, TMP1, Bytes - 1);
+      tbz_OrRestart(TMP1, 12, &Done);
+      add(ARMEmitter::Size::i64Bit, TMP2, TMP2, Bytes - 1);
+      ProbePage();
+    }
+    b_OrRestart(&Done);
+    BindOrRestart(&Slow);
+  }
+  // REP/lane helpers may carry their address, count or data in scratch
+  // registers. Preserve those scratch values even on their inline path.
+  sub(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, FrameSize);
+  stp<ARMEmitter::IndexType::OFFSET>(TMP1, TMP2, ARMEmitter::Reg::rsp, 48);
+  EmitAddress();
+  str(TMP2, ARMEmitter::Reg::rsp, 32);
+  if (Guards && PreserveScratch) {
+    ARMEmitter::ForwardLabel Fast;
+    ProbePage();
+    if (Bytes != 1) {
+      ldr(TMP2, ARMEmitter::Reg::rsp, 32);
+      and_(ARMEmitter::Size::i64Bit, TMP1, TMP2, 4095);
+      add(ARMEmitter::Size::i64Bit, TMP1, TMP1, Bytes - 1);
+      tbz_OrRestart(TMP1, 12, &Fast);
+      add(ARMEmitter::Size::i64Bit, TMP2, TMP2, Bytes - 1);
+      ProbePage();
+    }
+    BindOrRestart(&Fast);
+    ldp<ARMEmitter::IndexType::OFFSET>(TMP1, TMP2, ARMEmitter::Reg::rsp, 48);
+    add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, FrameSize);
+    b_OrRestart(&Done);
+    BindOrRestart(&Slow);
+  }
+  stp<ARMEmitter::IndexType::OFFSET>(TMP3, TMP4, ARMEmitter::Reg::rsp, 64);
+  str(ARMEmitter::XReg::x30, ARMEmitter::Reg::rsp, 40);
+  if (HostSupportsSVE256) {
+    mov(TMP1, 96);
+    st1b<ARMEmitter::SubRegSize::i8Bit>(VTMP1.Z(), PRED_TMP_32B, ARMEmitter::Reg::rsp, TMP1);
+    mov(TMP1, 128);
+    st1b<ARMEmitter::SubRegSize::i8Bit>(VTMP2.Z(), PRED_TMP_32B, ARMEmitter::Reg::rsp, TMP1);
+  } else {
+    stp<ARMEmitter::IndexType::OFFSET>(VTMP1.Q(), VTMP2.Q(), ARMEmitter::Reg::rsp, 96);
+  }
+  mrs(TMP1, ARMEmitter::SystemRegister::NZCV);
+  str(TMP1, ARMEmitter::Reg::rsp, 0);
+  mrs(TMP1, ARMEmitter::SystemRegister::FPCR);
+  str(TMP1, ARMEmitter::Reg::rsp, 8);
+  mrs(TMP1, FPSR);
+  str(TMP1, ARMEmitter::Reg::rsp, 16);
+  const auto SpillSize = SpillForABICall(false, TMP1);
+  ldr(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, SpillSize + 32);
+  LoadConstant(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r1, Bytes);
+  LoadConstant(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r2, Write ? 1 : 0);
+  LOGMAN_THROW_A_FMT(!DebugData->GuestOpcodes.empty(), "Memory check requires a precise guest opcode");
+  InsertGuestRIPMove(ARMEmitter::Reg::r3, Entry + DebugData->GuestOpcodes.back().GuestEntryOffset);
+  ldr(ARMEmitter::XReg::x16, &CheckAddress.Loc);
+  blr(ARMEmitter::Reg::r16);
+  str(ARMEmitter::XReg::x0, ARMEmitter::Reg::rsp, SpillSize + 24);
+  FillForABICall(false);
+  if (HostSupportsSVE256) {
+    mov(TMP1, 96);
+    ld1b<ARMEmitter::SubRegSize::i8Bit>(VTMP1.Z(), PRED_TMP_32B.Zeroing(), ARMEmitter::Reg::rsp, TMP1);
+    mov(TMP1, 128);
+    ld1b<ARMEmitter::SubRegSize::i8Bit>(VTMP2.Z(), PRED_TMP_32B.Zeroing(), ARMEmitter::Reg::rsp, TMP1);
+  } else {
+    ldp<ARMEmitter::IndexType::OFFSET>(VTMP1.Q(), VTMP2.Q(), ARMEmitter::Reg::rsp, 96);
+  }
+  ldr(TMP1, ARMEmitter::Reg::rsp, 0);
+  msr(ARMEmitter::SystemRegister::NZCV, TMP1);
+  ldr(TMP1, ARMEmitter::Reg::rsp, 8);
+  msr(ARMEmitter::SystemRegister::FPCR, TMP1);
+  ldr(TMP1, ARMEmitter::Reg::rsp, 16);
+  msr(FPSR, TMP1);
+  ldr(TMP2, ARMEmitter::Reg::rsp, 24);
+  ldr(ARMEmitter::XReg::x30, ARMEmitter::Reg::rsp, 40);
+  ldr(TMP1, ARMEmitter::Reg::rsp, 48);
+  ldp<ARMEmitter::IndexType::OFFSET>(TMP3, TMP4, ARMEmitter::Reg::rsp, 64);
+  ARMEmitter::ForwardLabel Allowed;
+  cbnz_OrRestart(ARMEmitter::Size::i64Bit, TMP2, &Allowed);
+  ldr(TMP2, ARMEmitter::Reg::rsp, 56);
+  add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, FrameSize);
+  // All registers and status are restored before trapping. No guest memory
+  // operation in the checked IR instruction has executed.
+  brk(0x4c4d);
+  BindOrRestart(&Allowed);
+  ldr(TMP2, ARMEmitter::Reg::rsp, 56);
+  add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, FrameSize);
+  b_OrRestart(&Done);
+  Align(8);
+  PlaceNamedSymbolLiteral(GuardAddress);
+  PlaceNamedSymbolLiteral(CheckAddress);
+  BindOrRestart(&Done);
+#endif
+}
