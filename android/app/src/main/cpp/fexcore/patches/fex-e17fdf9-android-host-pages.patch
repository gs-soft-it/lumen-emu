+inline const size_t FEX_HOST_PAGE_MASK = ~(FEX_HOST_PAGE_SIZE - 1);
+constexpr size_t FEX_HOST_PAGE_ALIGNMENT = 16384;
+#else
+constexpr size_t FEX_HOST_PAGE_SIZE = FEX_PAGE_SIZE;
+constexpr size_t FEX_HOST_PAGE_SHIFT = FEX_PAGE_SHIFT;
+constexpr size_t FEX_HOST_PAGE_MASK = FEX_PAGE_MASK;
+constexpr size_t FEX_HOST_PAGE_ALIGNMENT = FEX_PAGE_SIZE;
+#endif
